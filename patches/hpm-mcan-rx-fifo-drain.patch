diff --git a/drivers/can/mcan_hpmicro.c b/drivers/can/mcan_hpmicro.c
--- a/drivers/can/mcan_hpmicro.c
+++ b/drivers/can/mcan_hpmicro.c
@@ -273,13 +273,21 @@ __attribute__((section(".isr")))static void hpm_mcan_isr(const struct device *dev)
 {
     const struct hpm_mcan_config *cfg = dev->config;
     MCAN_Type *can = cfg->base;
     uint32_t flags = mcan_get_interrupt_flags(can);
+    /* A callback may queue the next frame; do not clear its completion later. */
+    mcan_clear_interrupt_flags(can, flags);
     /* New message is available in RXFIFO0 */
     if ((flags & MCAN_INT_RXFIFO0_NEW_MSG) != 0) {
