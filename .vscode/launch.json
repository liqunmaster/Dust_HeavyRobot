{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug H",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "flash_h",
            "executable": "${workspaceFolder}/build/build_h/zephyr/Dust_HeavyRobot.elf",
            "servertype": "openocd",
            "serverpath": "D:/MCU/hpm/tools/openocd/openocd.exe",
            "searchDir": [
                "D:/MCU/hpm/tools/openocd/tcl",
                "D:/MCU/hpm/hpm_sdk/boards/openocd"
            ],
            "configFiles": [
                "${workspaceFolder}/Board/hpm5361/vllink.cfg"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 10"
            ],
            "gdbPath": "D:/MCU/hpm/toolchains/rv32imac_zicsr_zifencei_multilib_b_ext-win/bin/riscv32-unknown-elf-gdb.exe",
            "showDevDebugOutput": "raw",
            "postLaunchCommands": []
        },
