{
    "cmake.sourceDirectory": "${workspaceFolder}/boards/Dust_HeavyRobot_H",
    "cmake.buildDirectory": "${workspaceFolder}/build/build_h",
    "cmake.buildType": "Debug",
    "cmake.generator": "Ninja",
    "cmake.configureOnOpen": false,
    "cmake.configureArgs": [
        "-DBOARD=hpm5361icb",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    ],
    "cmake.environment": {
        "ZEPHYR_BASE": "D:/MCU/zephyr/zephyrproject/zephyr",
        "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
        "ZEPHYR_SDK_INSTALL_DIR": "D:/MCU/zephyr/zephyr-sdk",
        "HPM_SDK_DIR": "D:/MCU/hpm/hpm_sdk"
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.path": "D:/MCU/flash/clangd/bin/clangd.exe",
    "clangd.arguments": [
        "--query-driver=D:/MCU/zephyr/zephyr-sdk/gnu/riscv64-zephyr-elf/bin/riscv64-zephyr-elf-gcc.exe",
        "--background-index",
        "--header-insertion=never"
    ],
    "search.useIgnoreFiles": false,
    "workbench.colorCustomizations": {
        "tree.indentGuidesStroke": "#0099ff"
    },
    "editor.insertSpaces": false,
    "editor.tabSize": 8,
    "editor.detectIndentation": false,
    "files.eol": "\n",
    "[c]": {
        "editor.formatOnSave": false,
        "editor.formatOnType": false
    },
    "[cpp]": {
        "editor.formatOnSave": false,
        "editor.formatOnType": false
    }
}
